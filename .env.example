# GMAPS · Open Agent Hackathon 2026. Placeholders only: copy to .env (gitignored) or export; never commit real values.
# Provider: nightshift | sample | local  (unset: nightshift if the two NIGHTSHIFT_* below are set, else sample)
GMAPS_PROVIDER=
# Meterless Nightshift runs locally: URL and runtime key are in the Nightshift Console; NVIDIA is added in its Providers tab
NIGHTSHIFT_BASE_URL=http://127.0.0.1:8088/v1
NIGHTSHIFT_API_KEY=<nightshift-runtime-key>
# a Nemotron id from: python3 tools/nightshift_smoke.py --models   (meterless/auto may route to non-NVIDIA models)
NIGHTSHIFT_MODEL=<nemotron-model-id>
NIGHTSHIFT_TIMEOUT_S=30
# Data layer: local | zetaris  (zetaris: NOT INTEGRATED, see docs/OPEN_AGENT_2026_SUBMISSION.md)
GMAPS_DATA=local
ZETARIS_URL=<zetaris-endpoint>
ZETARIS_USER=<user>
ZETARIS_PASSWORD=<password>
# Runway memory engine: local | meterless  (meterless: NOT INTEGRATED)
GMAPS_MEMORY=local
METERLESS_API_KEY=<your-meterless-key>
# Pre-existing local path (Raleigh, unchanged; LocalLLM refuses non-local URLs)
GMAPS_LLM_BASE_URL=http://127.0.0.1:8001/v1
GMAPS_LLM_MODEL=gmaps-parser
