# GMAPS local settings (no API keys: everything runs on this machine). Copy to .env or export before running the scripts.
# Demo page: cd ui_scaffold && python3 -m http.server $GMAPS_UI_PORT --bind 127.0.0.1
GMAPS_UI_PORT=8765
# Configuration A parser server (venue/start_demo.sh and demo/run_track.sh read PORT; default 8001)
PORT=8001
# Configuration B agent (venue/serve_lightning.sh; then PORT=8002 MODEL=lightning PROCEDURE=v3 demo/run_track.sh tools)
GMAPS_LIGHTNING_PORT=8002
# Parser URL and model for the runtime LLM fallback (venue/llm_fallback.py)
GMAPS_LLM_BASE_URL=http://127.0.0.1:8001/v1
GMAPS_LLM_MODEL=gmaps-parser
